raw `
captianroom_MapScripts::
	.byte 0
`

script captianroom_EventScript_Pokeball1{
 
    lockall
    showmonpic(SPECIES_SABLEYE, 10,3)
    msgbox("Do you want to choose sableye?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        givemon(SPECIES_SABLEYE, 5, ITEM_BERRY_JUICE, abilityNum=2, move1=MOVE_WILL_O_WISP, move2=MOVE_FAKE_OUT, move3=MOVE_QUASH, move4=MOVE_TAUNT)
        if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Recieved sableye")
            removeobject(3)
            setvar(VAR_UNUSED_0x40FB, 1)
            setvar(VAR_UNUSED_0x40FC, 1)
            setvar(VAR_UNUSED_0x40FD, 2)
            setflag(FLAG_UNUSED_0x021)
            setflag(FLAG_SYS_POKEMON_GET)
            call(NicknamePartyMon)
        }
        elif(var(VAR_RESULT) == MON_GIVEN_TO_PC){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Recieved sableye")
            removeobject(1)
            setflag(STARTED_GAME)
            call(NicknameBoxMon)
        }
        if(flag(FLAG_SYS_POKEMON_GET)){
            msgbox("dont be greedy!")
            removeobject(1)
            removeobject(4)
        }
        else{
            hidemonpic
            msgbox("No More Room")
        }
    }
    else{
        hidemonpic
        msgbox(NewProfessor_NotChosen)
    }
    waitmessage
    releaseall
    end
 
}

