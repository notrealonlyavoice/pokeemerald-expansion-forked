script ISLANDNEW_EventScript_restuppls {
	lockall
	MSGBOX(format("I suppose I can heal your pokemon"))
	waitmessage
	playfanfare(MUS_HEAL)
	special(HealPlayerParty)
	MSGBOX(format("All better now"))
	waitmessage
	closemessage
	releaseall
}


movement gocatchmon {
	walk_up
}

movement gocatchmon2 {
	walk_left
	face_up
}

movement gocatchmon3 {
	walk_right
	face_up
}

