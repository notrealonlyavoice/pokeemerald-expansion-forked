script ISLANDNEW_Trigger_triggerendscene1 {
	lockall
	applymovement(4, checkonplayerlastime)
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_PLAYER, checkonplayerlookatlady)
	waitmovement(0)
	MSGBOX(format("congrats on finishing this madness. Huge thanks to my two bugtesters. Boringperson and Matthew. also massive thanks to TEAM AQUA HIDEOUT (kyogre praise be!) and Ghoulsash for trainer see scripts. hopefully some updates in the future to make this less scruffy"))
	waitmessage
	applymovement(4, byemartlady)
	waitmovement(0)
	fadescreenspeed(FADE_TO_BLACK, 24)
	special(GameClear)
}

