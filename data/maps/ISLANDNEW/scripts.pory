script areyousure {
	msgbox(format("Are you sure? could be your only way off this island"), MSGBOX_YESNO) 
	if(var(VAR_RESULT) == YES){
		call(areyousure) 
	} else {
		call(remainingofcheckonplayercript)
	}
}

script remainingofcheckonplayercript {
	lockall
	setvar(VAR_0x8008, 3)
	MSGBOX(format("Great! lets get you started"))
	applymovement(1, letsago)
	waitmovement(0)
	applymovement(OBJ_EVENT_ID_PLAYER, playerletsago)
	waitmovement(0)
	setvar(VAR_0x8008, 4)
	MSGBOX(format("You might want to check out the mystery cave before challenging the other leaders. "))
	waitmessage
	MSGBOX(format("you might as well take this pokemon to help you, as I have no use for it. "))
	waitmessage
    givemon(SPECIES_MR_MIME, 5, ITEM_LEPPA_BERRY, abilityNum=1, move1=MOVE_TRICK, move2=MOVE_PROTECT, move3=MOVE_TRICK_ROOM, move4=MOVE_CONFUSION)
    if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Recieved MR-MIME")
            waitmessage
            call(NicknamePartyMon)
            closemessage
			}
    elif(var(VAR_RESULT) == MON_GIVEN_TO_PC){
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("Recieved MR-MIME")
            call(NicknameBoxMon)
			}
	else{
            hidemonpic
            msgbox("No More Room")
			}
	MSGBOX("I'll be in the seashore house")
	waitmessage
	closemessage
	applymovement(1, immadipfr)
	waitmovement(0)
	removeobject(1)
	releaseall

}

