movement wakeuphuman {
	walk_down * 4
}

movement correctfaceingdirection2 {
	face_up
}

movement letsago {
	walk_up * 16
	walk_right * 3
	walk_up * 3 
	face_right
}

movement playerletsago {
	walk_up * 16
	walk_right * 4 
	walk_up * 4 
}

movement playerletsago2 {
	walk_up * 17
	walk_right * 3 
	walk_up * 4 
}

movement playerletsago3 {
	walk_up * 17
	walk_right * 5 
	walk_up * 4 
} 

movement playerletsago4 {
	walk_up * 18
	walk_right * 4 
	walk_up * 4 
}

movement immadipfr {
	walk_left * 8
}

