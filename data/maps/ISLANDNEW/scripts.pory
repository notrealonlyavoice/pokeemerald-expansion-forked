mapscripts ISLANDNEW_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: ISLANDNEW_MapScripts_OnTransition
	MAP_SCRIPT_ON_RESUME: CableClub_OnResume
}

script ISLANDNEW_MapScripts_OnTransition {
	call(respawnendingnpc)
	end
}


script respawnendingnpc {
	if(flag(FLAG_respawnnpc)){
		showobjectat(4, MAP_ISLANDNEW)
	} else {
		hideobjectat(4, MAP_ISLANDNEW)
	}
	end
}

script ISLANDNEW_Trigger_triggeroneforcutscene{
	applymovement(OBJ_EVENT_ID_PLAYER, correctfaceingdirection2)
    MSGBOX(format("Hey! you finally woke up"))
    waitmessage
	closemessage
    applymovement(1, wakeuphuman)
    waitmovement(0)
	MSGBOX(format("the ship went down but you somehow survived.. who are you? ... ... ... you need to get to the johto region for research? well thats unfortunate. This island is closed off from most of the outside world. if you want to use one of our boats, youll have to complete the ISLAND CHALLENGE. but that is very hard as no one has been able to complete it yet. do YOU think you are up for the task?"))
	MSGBOX("accept the challenge", MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES){
            MSGBOX(format("You are very confident"))
			waitmessage
			setvar((VAR_0x8006), 2)
            call(remainingofcheckonplayercript)   
	} else {
		call(areyousure)
	}
}

