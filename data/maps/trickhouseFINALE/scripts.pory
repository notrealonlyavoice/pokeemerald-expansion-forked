`

script trickhouseFINALE_EventScript_Duditem {
    lockall
    MSGBOX("It's a Dud!")
    closemessage
    releaseall
}

script trickhouseFINALE_EventScript_realitem {
    lockall
    MSGBOX("A gear clicked somewhere in the floor")
    setflag(FLAG_realitempicked)
    setmetatile(3, 15, METATILE_TrickHousePuzzle_Door_Shuttered, FALSE)
    closemessage
    releaseall
} 

script trickhouseFINALE_EventScript_finalriddle {
    MSGBOX(format("This is it... one final riddle!"))
            MSGBOX(format("Begin the Final riddle?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES){
                message(format("Ha! lets see how attentive you've been! How many children have appeared through this hack?"))
                multichoice(25, 5, MULTI_RIDDLE_FINAL, 0)
                closemessage
                if(var(VAR_RESULT) == 0){
                    call(RFFailed)
                }
                elif(var(VAR_RESULT) == 1){
                    call(RFFailed)
                }
                elif(var(VAR_RESULT) == 2){
                    call(RFCorrect)
                }
            }else {
                MSGBOX(format(".... wut-"))
                closemessage
            }
}




script RFFailed {
    lockall
    MSGBOX(format("HAH! you players these days never pay attention!"))
    waitmessage
    clearflag(FLAG_realitempicked)
    setvar(VAR_UNUSED_0x40FD, 0)
    setvar(VAR_UNUSED_0x40DC, 0)
    setvar(VAR_UNUSED_0x40FC, 0)
    setvar(VAR_UNUSED_0x40DB, 0)
    fadescreen(FADE_TO_BLACK)
    warpsilent(MAP_TRICKHOUSE_FINALE, 20, 39)
    waitstate
}

script RFCorrect {
    lockall
    MSGBOX(format("....."))
    delay(20)
    MSGBOX(format("....."))
    delay(20)
    MSGBOX(format("very well. meet me in the room ahead for our final showdown!"))
    waitmessage
    closemessage
    applymovement(6, ominouswalkfr)
    waitmovement(0)
    removeobject(6)
    releaseall
}


movement ominouswalkfr {
    walk_up * 7
}

