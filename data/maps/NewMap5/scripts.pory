raw `
NewMap5_MapScripts::
	.byte 0
`

script NewMap5_EventScript_clevermanscript {
    faceplayer
    if(var(VAR_0x8008) == 6) {
        MSGBOX(format("Hello, I am Cleverman! I'm a distant relative of that doofus who runs the trick house. You can unlock items to help you with the ISLAND CHALLENGE if you answer my questions."))
        setvar(VAR_0x8008, 7)
    } elif(var(VAR_0x8008) == 7) {
        call(R1)
    } elif(var(VAR_0x8008) == 8){
        call(waitfornextriddle)
    } elif(var(VAR_0x8008) == 9) {
        call(R2) 
    } elif(var(VAR_0x8008) == 10) {
        call(waitfornextriddle)
    } elif(var(VAR_0x8008) == 11) {
        call(R3)
    } elif(var(VAR_0x8008) == 12) {
        call(waitfornextriddle)
    } elif(var(VAR_0x8008) == 13) {
        call(R4cutscene)
    }


}

script R1 {
    MSGBOX(format("Oh-ho, I can sense that someone here just won a battle. I have a riddle that, if answered correctly, will allow you to complete the next challenge easily. Are you ready?"))
            MSGBOX(format("do the riddle?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES){
                message(format("OK! here is your question. What is the most used pokemon in VGC as of 2024"))
                multichoice(25, 5, MULTI_RIDDLE_ONE, 0)
                closemessage
                if(var(VAR_RESULT) == 0){
                    setvar(VAR_0x8008, 8)
                    setflag(R1ANSWERGIVEN)
                    call(R1Correct)
                }
                elif(var(VAR_RESULT) == 1){
                    setvar(VAR_0x8008, 8)
                    setflag(R1ANSWERGIVEN)
                    call(R1Failed)
                }
                elif(var(VAR_RESULT) == 2){
                    setvar(VAR_0x8008, 8)
                    setflag(R1ANSWERGIVEN)
                    call(R1Failed)
                }
            }else {
                MSGBOX(format("did the dev remember to code itemless run viability?..... probably not"))
                closemessage
            }
}

script  R2 {
    MSGBOX(format("Oh-ho, Back for More? Lets see your riddle prowess this time! Same deal as befor ok?"))
            MSGBOX(format("do the second riddle?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES){
                message(format("OK! here is your question. What type of damage does the TANGA BERRY reduce?"))
                multichoice(25, 5, MULTI_RIDDLE_TWO, 0)
                closemessage
                if(var(VAR_RESULT) == 0){
                    setvar(VAR_0x8008, 10)
                    call(R2Correct)
                }
                elif(var(VAR_RESULT) == 1){
                    setvar(VAR_0x8008, 10)
                    call(R2Failed)
                }
                elif(var(VAR_RESULT) == 2){
                    setvar(VAR_0x8008, 10)
                    call(R2Failed)
                }
            }else {
                MSGBOX(format("Aw cmon, not this tough guy act again. I'm pretty sure you want my help"))
                closemessage
            }
}

script  R3 {
    MSGBOX(format("Cant resist the thrill of answering my riddles eh? very well, youve been doing well so far."))
            MSGBOX(format("Begin the Third riddle?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == YES){
                message(format("OK! Which of these pokemon have the lowest sptak"))
                multichoice(25, 5, MULTI_RIDDLE_THREE, 0)
                closemessage
                if(var(VAR_RESULT) == 0){
                    setvar(VAR_0x8008, 12)
                    call(R3Failed)
                }
                elif(var(VAR_RESULT) == 1){
                    setvar(VAR_0x8008, 12)
                    call(R3Correct)
                }
                elif(var(VAR_RESULT) == 2){
                    setvar(VAR_0x8008, 12)
                    call(R3Failed)
                }
            }else {
                MSGBOX(format("cmon you've done so well in the past riddles!"))
                closemessage
            }
}

script R4cutscene {
    lockall
    MSGBOX(format("wow.. you've made it this far. just one more island challenge...."))
    delay(40)
    MSGBOX("...")
    delay(40)
    MSGBOX("...")
    delay(40)
    MSGBOX(format("oh? you want another simple riddle... a and a free tool to help you in the last challenge...."))
    delay(40)
    MSGBOX(format("very well.. riddle me this: why would two strangers who've never met you suddenly decide to help you get off this island... ... ... ... She convinced me to give you a chance and i must say you've impressed me... unfortunatly your final challenge is ME! CLEVERMAN! GOOD LUCK CHALLENGER!"))
    delay(40)
    fadescreen(FADE_TO_BLACK)
    special(HealPlayerParty)
    warpsilent(MAP_TRICKHOUSE_FINALE, 20, 39)
    waitstate
}


script R1Correct {
    lockall
    MSGBOX(format("impressive, you saw through my trick. next time wont be so easy though. take this item as a reward"))
    giveitem(ITEM_FOCUS_SASH)
    playfanfare(MUS_OBTAIN_ITEM)
    closemessage
    releaseall

}

script R1Failed {
    lockall
    MSGBOX(format("HA, arent I clever to trick you like that-"))
    closemessage
    releaseall
}

script R2Correct {
    lockall
    MSGBOX(format("impressive, you saw through my trick again. take this item as to help you with the challanges."))
    setvar(VAR_0x8006, 7)
    giveitem(ITEM_MENTAL_HERB)
    playfanfare(MUS_OBTAIN_ITEM)
    closemessage
    releaseall
}

script R2Failed {
    lockall
    setvar(VAR_0x8006, 7)
    MSGBOX(format("HA, better luck next time!"))
    closemessage
    releaseall

}

script R3Correct {
    lockall
    MSGBOX(format("impressive, you're spot on. take your reward and shoo"))
    setvar(VAR_0x8006, 10)
    waitmessage
    givemon(SPECIES_BONSLY, 5, ITEM_BERRY_JUICE, abilityNum=0, move1=MOVE_SWITCHEROO, move2=MOVE_STEALTH_ROCK, move3=MOVE_TORMENT, move4=MOVE_ENDEAVOR)
    if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
        playfanfare(MUS_OBTAIN_ITEM)
        msgbox("Recieved Bonsly")
        waitmessage
        call(NicknamePartyMon)
        closemessage
        }
        elif(var(VAR_RESULT) == MON_GIVEN_TO_PC){
        playfanfare(MUS_OBTAIN_ITEM)
        msgbox("Recieved Bonsly")
        call(NicknameBoxMon)
        }
        else{
        hidemonpic
        msgbox("No More Room")
        }
    closemessage
    releaseall
}

script R3Failed {
    lockall
    setvar(VAR_0x8006, 10)
    MSGBOX(format("HA, You're REALLY bad at this HEHE"))
    closemessage
    releaseall

}

script waitfornextriddle {
    lockall
    MSGBOX(format("leave me alone for now until youve beaten more trainers"))
    closemessage
    releaseall
}

