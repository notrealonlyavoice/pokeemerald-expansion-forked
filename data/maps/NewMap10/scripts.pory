raw `
NewMap10_MapScripts::
.byte 0
`

script NewMap10_Eventscript_finalbattlelesgo {
    MSGBOX(format("You have arrived at the finale.. im impressed youve made it this far... beat me and you'll be free to go home..... "))
    waitmessage
    trainerbattle_double(TRAINER_LEROY, cleveman_Intro, cleverman_Outro, cleverman_NotEnoughMons, Postclevermanbattle)
}


text cleveman_Intro {
    "FIGHT WITH ALL YOU GOT"
}

text cleverman_Outro {
    "you are truly clever...."
}

text cleverman_NotEnoughMons {
    "is this a technical softlock? possibly-"
}

script Postclevermanbattle {
    lockall
    MSGBOX("I have no reason to keep you here any longer")
    waitmessage
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_UNUSED_0x409B, 1)
    setflag(FLAG_respawnnpc)
    delay(40)
    warpsilent(MAP_ISLANDNEW, 32, 4)
    waitstate
}