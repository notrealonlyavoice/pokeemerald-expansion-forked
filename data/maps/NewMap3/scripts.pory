movement checkonfriend {
    walk_down 
}

movement checkonfriend2 {
    walk_left 
    walk_down
}

movement checkonfriend3 {
    walk_left
    walk_down
}


script checkmovementsteps {
    if(var(VAR_FRIENDSHIP_STEP_COUNTER) == 80){
        MSGBOX("Placer text")
    }
}