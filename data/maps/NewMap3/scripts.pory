raw `
NewMap3_MapScripts::
	.byte 0
`

script NewMap3_Trigger_loadinscene {
    applymovement(OBJ_EVENT_ID_PLAYER, checkonfriend)
    msgbox(format("SAVE YOURSELF! I CANT HOLD ON MUCH LONGER"))
    closemessage
    call(ShipWrekCut)
    delay(20)
    fadescreen(FADE_TO_BLACK)
    removeobject(1)
    setvar(VAR_0x8008, 1)
    setflag(FRIEND_IS_DED)
    fadescreen(FADE_FROM_BLACK)


}

