mapscripts SHIPPP_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: SHIPPP_MapScripts_OnTransition
	MAP_SCRIPT_ON_RESUME: CableClub_OnResume
}

script SHIPPP_MapScripts_OnTransition {
    setrespawn(HEAL_LOCATION_SHIPPP)
    end
}

script SHIPPP_EventScript_SailorMessage {
    lockall 
    applymovement(1, LookAtPlayer)
    MSGBOX(Format("These Doors go striaght to the deck")) 
    releaseall   
}

movement LookAtPlayer{
    faceplayer
}

script SHIPPP_Trigger_BlockDoorScript{
    lockall 
    msgbox("the captian was looking for you")
    applymovement(OBJ_EVENT_ID_PLAYER, StopPlayerSHIP)
    waitmovement(0) 
    releaseall  
} 

movement StopPlayerSHIP{
	walk_right * 2 
}

script SHIPPP_Trigger_BlockDoorScript2{
    lockall
    msgbox("the captian was looking for you")
    applymovement(OBJ_EVENT_ID_PLAYER, StopPlayerNOPOKEMON)
    waitmovement(0)
    releaseall
}

movement StopPlayerNOPOKEMON{
    walk_up * 1
}

script SHIPPP_EventScript_SillyKid{
    lockall
    faceplayer
    msgbox("do you want to see this msg again?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        closemessage
        call(SHIPPP_EventScript_SillyKid)
    }
    else{
        msgbox("awwww")
        closemessage
    }
}


script SHIPPP_EventScript_scientisttest {
    lockall
    msgbox("HELLO!")
    waitmessage
    closemessage
    warpsilent(MAP_NEW_MAP8, 7, 8)
    waitstate
}