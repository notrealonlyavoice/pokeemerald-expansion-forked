script ISLANDNEW_EventScript_randomguy {
	lockall
	MSGBOX(format("NO!! 255 sptak ev zoroark 100% one shots you I DID THE CALCS!!!"))
	waitmessage
	closemessage
	releaseall
}

script ISLANDNEW_EventScript_randomguy1 {
	lockall
	MSGBOX(format("NO! I'm MAX HP and i set up amnesia TWO TURNS AGO. I LIVE THE DARK PULSE"))
	waitmessage
	closemessage
	releaseall
}


script ISLANDNEW_EventScript_sameladyasbefore {
    if(var(VAR_0x8006) == 4 ){
        MSGBOX(format("I belive in you!"))
		closemessage
    }elif(var(VAR_0x8006) == 3 ){
		MSGBOX(format("Good luck!"))
		closemessage
	} elif(var(VAR_0x8006) == 5 ){
		MSGBOX(format("Congrats on Beating the first of 4 ISLAND CHALLENGES"))
		setvar(VAR_0x8006, 6)
		closemessage
	} elif(var(VAR_0x8006) == 8 ){
		MSGBOX(format("Congrats on Being HALFWAY DONE with the ISLAND CHALLENGES, at this rate you'll be home in no time"))
		setvar(VAR_0x8006, 9)
		closemessage
	}elif(var(VAR_0x8006) == 7 ){
		MSGBOX(format("OK! Now that you are ready let me give you a brief overview of the second challenge. SPINCLOPS FOREST is a spooky place where the second challenge leader resides. you will need skill to navigate towards it... "))
		delay(20)
		MSGBOX("...")
		delay(20)
		MSGBOX("...")
		delay(20)
		MSGBOX(format("Oh by the way you cant really escape the forest unless you beat--"))
		fadescreen(FADE_TO_BLACK)
		delay(40)
		warpsilent(MAP_NEW_MAP6, 5, 7)
		waitstate
	}elif(var(VAR_0x8006) == 10 ){
		MSGBOX(format("OK! The third challenge leader is very young and spends most of his time playing in the ice caves. navigating the caves are treacherous and maybe HM STRENGTH would help..... hmmm....."))
		setvar(VAR_0x8006, 11)
		closemessage
	} elif(var(VAR_0x8006) == 6 ){
		MSGBOX(format("Go check if cleverman has any riddles for you before you start the next ISLAND CHALLENGE"))
		closemessage
	} elif(var(VAR_0x8006) == 11 ){
		MSGBOX(format("Good luck!"))
		closemessage
	} elif(var(VAR_0x8006) == 9 ){
		MSGBOX(format("Go check Check if cleverman has another riddle ready for you"))
		closemessage
	}elif(var(VAR_0x8006) == 12 ){
		MSGBOX(format("You've come so far! go talk to cleverman before i give you the briefing on your last challenge!"))
		closemessage
	} else {
	lockall
	MSGBOX(format("oh hello. Ready to start the challenge?"))
    waitmessage
    MSGBOX(format("are you ready?"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES){
        MSGBOX(format("Ok! Master trought lies at the end of the CONJOINED TUNNELS in mystery cave, but navigating it is treacherous... find someone who knows the combination")) 
        setvar((VAR_0x8006), 3)
		closemessage
    }
    else{
        MSGBOX(format("later then. keep exploring"))
        closemessage
    }
    }
}



